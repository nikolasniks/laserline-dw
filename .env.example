# Copy to .env and fill in. NEVER commit the real file.

# --- Calcme API ---
CALCME_BASE_URL=https://api.example-calcme.com
CALCME_API_TOKEN=changeme
CALCME_TIMEOUT_SECONDS=30
CALCME_PAGE_SIZE=100

# --- Postgres (RDS) ---
PGHOST=your-instance.xxxxxxxx.sa-east-1.rds.amazonaws.com
PGPORT=5432
PGDATABASE=laserline_dw
PGUSER=etl_writer
PGPASSWORD=changeme
PGSSLMODE=require

# --- AWS ---
AWS_REGION=sa-east-1
REPORTS_BUCKET=laserline-dw-reports
# In Lambda, prefer pulling DB creds from Secrets Manager instead of env vars
DB_SECRET_ARN=

# --- Misc ---
LOG_LEVEL=INFO
TZ=America/Sao_Paulo
